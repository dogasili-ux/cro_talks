<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mini Discord</title>
  <style>
    :root {
      --bg-dark: #36393f;
      --bg-darker: #2f3136;
      --bg-light: #40444b;
      --primary: #5865f2;
      --text: #dcddde;
    }
    body {
      background-color: var(--bg-dark);
      margin: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      color: var(--text);
      display: flex;
      height: 100vh;
      overflow: hidden;
    }
    
    /* Ana Ekran Düzeni */
    .main { flex: 1; display: flex; flex-direction: column; }
    .main-videos {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      padding: 20px;
      gap: 15px;
      overflow-y: auto;
      background-color: var(--bg-dark);
    }
    
    /* Video Kutuları */
    .video-container {
      position: relative;
      width: 300px;
      height: 225px;
      border-radius: 8px;
      overflow: hidden;
      background: black;
      border: 2px solid var(--bg-light);
    }
    video { width: 100%; height: 100%; object-fit: cover; }
    .user-tag {
      position: absolute;
      bottom: 5px; left: 5px;
      background: rgba(0,0,0,0.6);
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 12px;
      color: white;
    }

    /* Sağ Sohbet Paneli */
    .main-right {
      width: 300px;
      background-color: var(--bg-darker);
      display: flex;
      flex-direction: column;
      border-left: 1px solid #202225;
    }
    .header { padding: 15px; border-bottom: 1px solid #202225; font-weight: bold; text-align: center;}
    .chat-window { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 10px;}
    .messages { list-style: none; padding: 0; margin: 0; }
    .message-item { font-size: 0.9rem; word-break: break-word; }
    .message-item b { color: var(--primary); margin-right: 5px; }
    
    .chat-input-area { padding: 15px; background-color: var(--bg-light); }
    input {
      width: 100%; padding: 10px; border-radius: 5px;
      border: none; background-color: var(--bg-light);
      color: white; outline: none; box-sizing: border-box;
    }

    /* Alt Kontrol Barı */
    .controls {
      height: 80px;
      background-color: #202225;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 20px;
    }
    .control-btn {
      width: 50px; height: 50px;
      border-radius: 50%;
      background-color: var(--bg-light);
      border: none; cursor: pointer;
      display: flex; justify-content: center; align-items: center;
      transition: 0.2s;
      font-size: 20px; color: white;
    }
    .control-btn:hover { background-color: var(--primary); }
    .control-btn.active { background-color: #ed4245; } /* Kırmızı durum */
    .control-btn.screen-share { background-color: #3ba55c; }
    
    /* İkonlar yerine basit metin kullanıyoruz, istenirse FontAwesome eklenebilir */
  </style>
  <script> const ROOM_ID = "<%= roomId %>"; </script>
  <script src="https://unpkg.com/peerjs@1.3.1/dist/peerjs.min.js"></script>
  <script src="/socket.io/socket.io.js" defer></script>
  <script src="script.js" defer></script>
</head>
<body>
  
  <div class="main">
    <div class="main-videos" id="video-grid">
      </div>
    
    <div class="controls">
      <button class="control-btn" id="muteButton" title="Mikrofonu Kapat">🎤</button>
      <button class="control-btn" id="stopVideoButton" title="Kamerayı Kapat">📷</button>
      <button class="control-btn screen-share" id="screenShareButton" title="Ekran Paylaş">🖥️</button>
      <button class="control-btn active" onclick="window.close()" title="Ayrıl">❌</button>
    </div>
  </div>

  <div class="main-right">
    <div class="header">Sohbet Odası</div>
    <div class="chat-window">
      <ul class="messages" id="messagesList"></ul>
    </div>
    <div class="chat-input-area">
      <input id="chat_message" type="text" placeholder="Bir mesaj yaz...">
    </div>
  </div>

</body>
</html>